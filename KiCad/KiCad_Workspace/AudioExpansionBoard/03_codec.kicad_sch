	(text "Component Specs (as per the TI tac5212 Datasheet)\n- C5: 	1u		(16V)\n- C6: 	0.1u	(16V)\n- C7: 	10u		(16V)\n- C8: 	10u		(16V)\n- C9: 	0.1u	(16V)\n- C10: 	10u 	(16V)\n- C11: 	0.1u 	(16V)\n- C12: 	4.7n	(??V (not specified))\n- C13: 	4.7n	(??V (not specified))"
